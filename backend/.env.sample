PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/wp-bot
JWT_SECRET=change-this-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:5173

# Seeded owner login (npm run seed)
OWNER_EMAIL=owner@demo.local
OWNER_PASSWORD=changeme
OWNER_NAME=Owner

# Meta WhatsApp Cloud API
# WHATSAPP_ACCESS_TOKEN = system user token (whatsapp_business_messaging + whatsapp_business_management)
# WHATSAPP_PHONE_NUMBER_ID = Phone number ID on API Setup (not the +91 display number)
# WHATSAPP_BUSINESS_ACCOUNT_ID = WABA ID on API Setup
# WHATSAPP_VERIFY_TOKEN = any string; must match Meta webhook verify token
# WHATSAPP_APP_SECRET = App secret (X-Hub-Signature-256)
# WHATSAPP_DISPLAY_NUMBER = 91XXXXXXXXXX for the printed QR
WHATSAPP_APP_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=wp-bot-verify
WHATSAPP_APP_SECRET=
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_API_VERSION=v25.0

# Razorpay Dashboard → API Keys + Webhooks
# WEBHOOK_SECRET is the secret you set on the webhook, not the API key secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
